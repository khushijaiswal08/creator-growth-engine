# Copy to .env and fill in. Never commit .env.

# Neon PostgreSQL. DATABASE_URL is the pooled connection (host contains "-pooler"),
# DIRECT_URL is the direct connection used by `prisma migrate`.
# Keep connect_timeout and pool_timeout: Neon puts an unused database to sleep, and waking it
# can take longer than Prisma's default 5 seconds, which makes the first request (often a
# sign-in) fail.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15&pool_timeout=20"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Auth.js session secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"
AUTH_SECRET=""
# Needed on Netlify and when running `next start` yourself (Vercel sets it automatically).
AUTH_TRUST_HOST="true"
# The public address, so sign-in redirects and cookies always use it and never a host-internal one
# (Netlify hands its functions a per-deploy address). Same value as APP_URL in production.
AUTH_URL=""

# Creator-fetching adapter used by default (by Add creator): csv | manual | meta_free | youtube | vendor
# vendor is still a stub and throws NotImplemented; manual is the usual choice.
CREATOR_SOURCE="manual"

# The site's public address, used in creators' product-selection and upload links and by the scheduled functions.
# Leave empty locally (it is read from the request); set it on Netlify, e.g. https://creators.yourdomain.com
APP_URL=""

# Encrypts creators' shipping details before they are stored. 32 random bytes in base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production. Keep a copy somewhere safe: without it, stored addresses cannot be read.
ADDRESS_ENCRYPTION_KEY=""

# Secret the schedulers send to /api/cron/automations, /api/cron/jobs and /api/cron/weekly-summary (/api/cron/check asks for it too). Any long random string.
# The Netlify scheduled functions in netlify/functions read it from the environment.
CRON_SECRET=""

# Weekly summary email to the admin (Monday). SMTP_URL example for Google Workspace or Gmail with an app password:
#   smtps://you%40yourdomain.com:app-password@smtp.gmail.com:465
# Leave empty and no email is sent.
SMTP_URL=""
SUMMARY_EMAIL_FROM=""
SUMMARY_EMAIL_TO=""

# Monitored address shown on the /privacy and /terms pages.
LEGAL_CONTACT_EMAIL=""

# IANA time zone used when showing timestamps, e.g. America/New_York or Asia/Kolkata.
APP_TIME_ZONE="UTC"

# Password given to the admin user by `pnpm db:seed`. Change it after first sign-in (Change password).
SEED_USER_PASSWORD=""

# ---- Phase 1 discovery and scoring. Server-side only: never prefix with NEXT_PUBLIC_. ----

# YouTube Data API v3 key (Google Cloud Console > APIs & Services > Credentials).
# Leave empty and YouTube discovery reports "not configured".
YOUTUBE_API_KEY=""
# Daily allowance of the key (Google's default is 10,000 units). Discovery stops at 80% of it.
YOUTUBE_DAILY_QUOTA="10000"

# Instagram discovery through Meta's Graph API: hashtag search and the Creator
# Marketplace. The Creator Marketplace needs a Facebook PAGE access token (a
# user token is refused with code 190); hashtag search needs an app approved for
# "Instagram Public Content Access". IG_BUSINESS_ID is the Instagram business
# account id (see Graph API Explorer: <Page id>?fields=instagram_business_account). Secret: server only,
# never printed. Leave empty for "not configured".
META_ACCESS_TOKEN=""
IG_BUSINESS_ID=""
# Optional: pin a Graph API version. Empty: hashtag search uses your app's
# default and the Creator Marketplace uses v27.0 (the version it was tested with).
META_GRAPH_VERSION=""
# Optional: the Creator Marketplace fields to request, comma separated, e.g.
# "username,name,biography,followers_count". Overrides MARKETPLACE_FIELDS in
# src/lib/fetching/adapters/creator-marketplace.ts. Find the names with
# Admin › Connected services › Check available fields.
META_MARKETPLACE_FIELDS=""

# Anthropic API key for AI fit scoring and the reply reader. Leave empty for "not configured" (replies are then read by the built-in rules).
ANTHROPIC_API_KEY=""
# Optional: model used for scoring. Default claude-opus-5-5.
ANTHROPIC_MODEL=""

# Key for a paid creator-data vendor (adapter is still a stub).
# VENDOR_API_KEY=""
